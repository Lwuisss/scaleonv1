# TOBIM Çevre Değişkenleri

# 1. Port Ayarı (Yerel çalıştırma için)
PORT=3000

# 2. Gerçek E-posta Gönderimi (SMTP)
# Örnek: Gmail için Google Hesabı -> Güvenlik -> 2 Adımlı Doğrulama -> Uygulama Şifreleri (App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=senin.emailin@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Tobim" <noreply@tobim.app>

# 3. Veritabanı (Opsiyonel: Vercel Postgres / Supabase / Neon)
# Boş bırakılırsa yerel JSON veritabanı (data/tobim.json) otomatik kullanılır.
# Vercel'de Vercel Postgres bağlandığında POSTGRES_URL otomatik tanımlanır.
# POSTGRES_URL=postgres://user:password@host:5432/dbname
